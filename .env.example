SITE_NAME=센터의 하루
FLASK_SECRET_KEY=change-this-secret
SEED_DEMO=1

# 1이면 서버가 주기적으로 Instagram Story를 확인합니다.
ENABLE_SCHEDULER=0
SYNC_INTERVAL_MINUTES=10

# Instagram API with Instagram Login을 쓸 때 기본값
META_API_BASE=https://graph.instagram.com
META_GRAPH_VERSION=v26.0
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=

# 공통 하단 문의 버튼 링크 (예: mailto:hello@example.com 또는 카카오톡 채널 URL)
CONTACT_URL=
